# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Site ---
# Canonical origin used for metadata, sitemap and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.tridentcoreenergy.com
# Google Search Console → Add property → HTML tag: paste only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Public contact details (optional; values in src/content/company.ts take priority) ---
# Each item only renders when set.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Lead delivery: email via Resend ---
RESEND_API_KEY=
# Comma-separated list of recipients.
ENQUIRY_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Trident Core Website <website@yourdomain.com>".
ENQUIRY_FROM_EMAIL=

# --- Lead delivery: optional CRM webhook (receives JSON { kind, source, submittedAt, fields }) ---
CRM_WEBHOOK_URL=
# Sent as "Authorization: Bearer <secret>" when set.
CRM_WEBHOOK_SECRET=

# --- Spam protection: Cloudflare Turnstile (verification is skipped when the secret is unset) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (loads only after the visitor accepts cookies) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
